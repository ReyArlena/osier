{
  "$schema": "https://gpui-kit.com/schemas/theme.json",
  "name": "My themes",
  "author": "your name",
  "themes": [
    {
      "name": "My Dark",
      "mode": "dark",
      "colors": {
        "background": "#1e1e2e",
        "foreground": "#cdd6f4",
        "border": "#45475a",
        "title_bar.background": "#181825",
        "sidebar.background": "#181825",
        "status_bar.background": "#181825",
        "tab_bar.background": "#181825",
        "panel.background": "#313244",
        "popover.background": "#313244",
        "muted.foreground": "#a6adc8",
        "primary.background": "#89b4fa",
        "primary.foreground": "#1e1e2e",
        "danger.background": "#f38ba8",
        "success.background": "#a6e3a1",
        "warning.background": "#f9e2af",
        "list.active.background": "#89b4fa22",
        "list.hover.background": "#45475a80"
      },
      "highlight": {
        "created": "#a6e3a1",
        "deleted": "#f38ba8",
        "modified": "#f9e2af",
        "conflict": "#eba0ac",
        "editor.line_number": "#6c7086",
        "syntax": {
          "keyword": { "color": "#cba6f7" },
          "string": { "color": "#a6e3a1" },
          "comment": { "color": "#6c7086", "font_style": "italic" },
          "function": { "color": "#89b4fa" },
          "type": { "color": "#f9e2af" },
          "number": { "color": "#fab387" }
        }
      }
    }
  ]
}
