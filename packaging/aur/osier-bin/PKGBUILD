# Maintainer: Rey Arlena <reyarlena@gmail.com>
pkgname=osier-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Fast native git GUI (prebuilt binary)"
arch=(x86_64 aarch64)
url="https://github.com/ReyArlena/osier"
license=(MIT)
depends=(git libxkbcommon libxkbcommon-x11 wayland vulkan-icd-loader fontconfig gcc-libs glibc)
optdepends=('github-cli: multi-account GitHub authentication')
provides=(osier)
conflicts=(osier)
source_x86_64=("$url/releases/download/v$pkgver/osier-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/osier-$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')  # filled in when the release tag exists
sha256sums_aarch64=('SKIP')

package() {
  cd "osier-$pkgver-${CARCH}-unknown-linux-gnu"
  install -Dm755 osier "$pkgdir/usr/bin/osier"
  install -Dm644 com.reyarlena.osier.desktop "$pkgdir/usr/share/applications/com.reyarlena.osier.desktop"
  install -Dm644 com.reyarlena.osier.askpass.desktop "$pkgdir/usr/share/applications/com.reyarlena.osier.askpass.desktop"
  install -Dm644 com.reyarlena.osier.metainfo.xml "$pkgdir/usr/share/metainfo/com.reyarlena.osier.metainfo.xml"
  for s in 16 32 48 64 128 256 512; do
    install -Dm644 "icons/hicolor/${s}x${s}/apps/com.reyarlena.osier.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/com.reyarlena.osier.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
